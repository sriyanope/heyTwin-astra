{
  "name": "heytwin-astra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "build": "node scripts/check-syntax.mjs && node scripts/build-catalogue.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "catalogue:discover": "node scripts/catalogue/fetch-commons.mjs discover",
    "catalogue:build": "node scripts/catalogue/build.mjs",
    "catalogue:contact-sheet": "node scripts/catalogue/contact-sheet.mjs",
    "catalogue:report": "node scripts/catalogue/report.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "@google/model-viewer": "^4.1.0"
  }
}
